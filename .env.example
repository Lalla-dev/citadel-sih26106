# ==============================================================================
# Citadel Security Platform - Environment Configuration Reference
# ==============================================================================
# Copy this file to .env and configure for your deployment environment.
# Never commit real credentials or secret tokens to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Backend Configuration
# ------------------------------------------------------------------------------
# Production / Docker Compose:
# Full PostgreSQL connection string used by the SQLAlchemy persistence layer.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://citadel_user:citadel_demo_password@postgres:5432/citadel_db

# Local Development / Offline Fallback:
# If DATABASE_URL is omitted or empty, Citadel automatically uses the persistent
# local SQLite backend: sqlite:///./citadel_persistence.db
#
# IMPORTANT FAILURE BEHAVIOR:
# If DATABASE_URL starts with 'postgresql://', Citadel requires a successful
# PostgreSQL connection. If connection fails, it raises an explicit ConnectionError
# and will NOT silently fall back to SQLite.

# ------------------------------------------------------------------------------
# PostgreSQL Service Settings (Used by docker-compose.yml)
# ------------------------------------------------------------------------------
POSTGRES_USER=citadel_user
POSTGRES_PASSWORD=citadel_demo_password
POSTGRES_DB=citadel_db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Application Server Settings
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
